#!/bin/bash

# Author: gzzcoo

# Colours
green="\e[0;32m\033[1m"
end="\033[0m\e[0m"
red="\e[0;31m\033[1m"
blue="\e[0;34m\033[1m"
yellow="\e[0;33m\033[1m"
purple="\e[0;35m\033[1m"
turquoise="\e[0;36m\033[1m"
gray="\e[0;37m\033[1m"

echo -e "${yellow}"
echo '  _ _____            _             '
echo ' (_)  __ \          | |          '
echo '  _| |__) |___  __ _| |_ __ ___  '
echo ' | |  _  // _ \/ _` | | `_ ` _ \ '
echo ' | | | \ \  __/ (_| | | | | | | |'
echo ' |_|_|  \_\___|\__,_|_|_| |_| |_|'
echo -e "${end}"

# Help Menu
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo -e "${purple}Description:${end} A tool to automate /etc/hosts and /etc/krb5.conf configuration for AD CTFs.\n"
    echo -e "${yellow}Usage:${end} $0 [OPTIONS]"
    echo -e "\n${turquoise}Options:${end}"
    echo -e "  -i, --ip <IP>          Target IP address"
    echo -e "  -d, --domain <FQDN>    Target Domain (e.g., domain.htb)"
    echo -e "  -n, --hostname <NAME>  Target Hostname (e.g., DC01)"
    echo -e "  --cross-forest         Append to krb5.conf for cross-forest trusts instead of overwriting"
    echo -e "  --sync-time            Attempt to sync time with the DC using rdate (SNTP/UDP) + faketime"
    echo -e "  --tcp-sync             Same as --sync-time but uses TCP (RFC868) — compatible with proxychains"
    echo -e "  --force                Run non-interactively (requires -i, -d, -n)"
    echo -e "  -h, --help             Show this help message\n"
    exit 0
fi

# Default Configuration
force=false
cross_forest=false
sync_time=false
tcp_sync=false

# Argument Parsing
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --force) force=true ;;
        --cross-forest) cross_forest=true ;;
        --sync-time) sync_time=true ;;
        --tcp-sync) tcp_sync=true; sync_time=true ;;
        -i|--ip) ip="$2"; shift ;;
        -d|--domain) domain="$2"; shift ;;
        -n|--hostname) hostname="$2"; shift ;;
        *) 
            echo -e "${red}[✘] Unknown argument: $1${end}"
            echo -e "${yellow}Use -h or --help for usage information.${end}"
            exit 1 
            ;;
    esac
    shift
done

# Validations or Interactive Mode
if [[ -z "$ip" || -z "$domain" || -z "$hostname" ]]; then
    if $force; then
        echo -e "\n${red}[✘] Missing arguments in --force mode.${end}"
        echo -e "\n${yellow}Usage:${end} $0 [--force] [--cross-forest] [--sync-time] -i <IP> -d <DOMAIN> -n <HOSTNAME>"
        exit 1
    fi

    echo -ne "\n${yellow}[!]${end} ${purple}IP address:${end} "
    read ip

    echo -ne "${yellow}[!]${end} ${purple}Domain name (${turquoise}e.g. domain.htb${end}${purple}):${end} "
    read domain

    echo -ne "${yellow}[!]${end} ${purple}Hostname (${turquoise}e.g. dc${end}${purple}):${end} "
    read hostname
    
    echo -ne "${yellow}[!]${end} ${purple}Is this an additional domain to append to /etc/krb5.conf? (${turquoise}y/n${end}${purple}):${end} "
    read resp_cross
    [[ "$resp_cross" =~ ^[Yy]$ ]] && cross_forest=true

    echo -ne "${yellow}[!]${end} ${purple}Do you want to sync local time with the DC (faketime/rdate)? (${turquoise}y/n${end}${purple}):${end} "
    read resp_time
    [[ "$resp_time" =~ ^[Yy]$ ]] && sync_time=true
fi

fqdn="$hostname.$domain"
realm_upper=$(echo "$domain" | awk '{print toupper($0)}')
line_to_add="$ip $fqdn $domain $hostname"

# 1. /etc/hosts Cleanup and Update
if [[ -f /etc/hosts ]]; then
    sudo cp /etc/hosts /etc/hosts.bak 2>/dev/null
    echo -e "\n🗂️  ${purple}Backup saved as${end} ${turquoise}/etc/hosts.bak${end}"
fi

# Finds and removes previous lines matching the FQDN (case-insensitive)
if grep -iE "[[:space:]]$fqdn([[:space:]]|$)" /etc/hosts > /dev/null; then
    echo -e "🧹 ${purple}Cleaning up previous conflicting entries in${end} ${turquoise}/etc/hosts${end}${purple}...${end}"
    
    cp /etc/hosts /tmp/hosts.tmp
    sed -i -E "/[[:space:]]$fqdn([[:space:]]|$)/Id" /tmp/hosts.tmp
    cat /tmp/hosts.tmp | sudo tee /etc/hosts > /dev/null
    rm /tmp/hosts.tmp
fi

if grep -Fxq "$line_to_add" /etc/hosts; then
    echo -e "⚠️  ${purple}Entry already exists in${end} ${turquoise}/etc/hosts${end}${purple}. Skipping...${end}"
else
    if ! $force; then
        echo -e "\n💡 ${purple}Entry to add to${end} ${turquoise}/etc/hosts${end}${purple}:${end}"
        echo -e "$line_to_add"
        echo -ne "\n✅ ${purple}Do you want to add this to ${end}${turquoise}/etc/hosts${end}${purple}? (${turquoise}y/n${end}${purple}):${end} "
        read confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo -e "\n❌ ${red}Cancelled. Exiting.${end}"
            exit 1
        fi
    fi
    echo "$line_to_add" | sudo tee -a /etc/hosts > /dev/null
    echo -e "✅ ${purple}Added to${end} ${turquoise}/etc/hosts${end}${purple}!${end}"
fi

# 2. krb5.conf Backup and Update
if [[ -f /etc/krb5.conf ]]; then
    sudo cp /etc/krb5.conf /etc/krb5.conf.bak 2>/dev/null
    echo -e "\n🗂️  ${purple}Backup saved as${end} ${turquoise}/etc/krb5.conf.bak${end}"
fi

if $cross_forest && grep -q "\[realms\]" /etc/krb5.conf; then
    echo -e "🌲 ${purple}Adding Cross-Forest config to ${end}${turquoise}/etc/krb5.conf${end}${purple}...${end}"
    
    realm_exists=$(grep -cP "^\s+${realm_upper}\s*=" /etc/krb5.conf 2>/dev/null || true)
    dom_exists=$(grep -cP "^\s+\.${domain,,}\s+=\s+${realm_upper}\s*$" /etc/krb5.conf 2>/dev/null || true)

    awk -v realm="${realm_upper}" -v fqdn="${fqdn}" -v dom="${domain,,}" -v add_realm="${realm_exists}" -v add_dom="${dom_exists}" '
    /^\[libdefaults\]/ { in_libdefaults=1 }
    in_libdefaults && /default_realm/ {
        print "    default_realm = " realm
        in_libdefaults=0
        next
    }
    /^\[realms\]/ {
        print
        if (add_realm == 0) {
            print "    " realm " = {"
            print "        kdc = " fqdn
            print "        admin_server = " fqdn
            print "    }"
        }
        next
    }
    /^\[domain_realm\]/ {
        print
        if (add_dom == 0) {
            print "    ." dom " = " realm
            print "    " dom " = " realm
        }
        next
    }
    1' /etc/krb5.conf > /tmp/krb5_temp.conf && sudo mv /tmp/krb5_temp.conf /etc/krb5.conf
else
    echo -e "🧹 ${purple}Replacing ${end}${turquoise}/etc/krb5.conf${end}${purple}...${end}"
    sudo tee /etc/krb5.conf > /dev/null <<EOF
[libdefaults]
    default_realm = ${realm_upper}
    dns_lookup_realm = false
    dns_lookup_kdc = false
    ticket_lifetime = 24h
    renew_lifetime = 7d
    forwardable = true
    rdns = false

[realms]
    ${realm_upper} = {
        kdc = ${fqdn}
        admin_server = ${fqdn}
    }

[domain_realm]
    .${domain,,} = ${realm_upper}
    ${domain,,} = ${realm_upper}
EOF
fi

echo -e "\n🎉 ${green}Done! Hosts and Kerberos config updated.${end}"

# 3. Optional Time Sync
if $sync_time; then
    echo -e "\n⏰ ${purple}Syncing time with DC...${end}"
    current_shell="${SHELL##*/}"
    rdate_flags="-n"
    rdate_hint="-n"
    if $tcp_sync; then
        echo -e "   ${yellow}(using TCP — compatible with proxychains)${end}"
        rdate_flags=""
        rdate_hint=""
    fi
    # Added a 80-second timeout in case the rdate port is filtered
    time_str=$(timeout 80 rdate $rdate_flags $ip -p 2>/dev/null | awk '{print $2, $3, $4}')
    if [[ -n "$time_str" ]]; then
        formatted_time=$(echo "$time_str" | date -f - "+%Y-%m-%d %H:%M:%S")
        
        echo -e "\n⚠️  ${yellow}Important Note regarding faketime:${end}"
        echo -e "   - You will be dropped into a faked time subshell. To return to normal time, type '${red}exit${end}'."
        echo -e "   - ${red}DO NOT${end} run iRealm with --sync-time again inside this shell to avoid nesting issues."
        echo -e "   - To apply this exact time sync to a NEW terminal, simply run:"
        echo -e "     ${turquoise}faketime \"\$(rdate $rdate_hint $ip -p | awk '{print \$2, \$3, \$4}' | date -f - '+%Y-%m-%d %H:%M:%S')\" $current_shell${end}\n"
        
        faketime "$formatted_time" "$current_shell"
    else
        echo -e "${red}[✘] Could not fetch time from DC. Check connectivity or firewall.${end}"
    fi
else
    echo -e "\n⏳ ${gray}Time sync skipped.${end}"
fi

echo -e "\n Exit..."
